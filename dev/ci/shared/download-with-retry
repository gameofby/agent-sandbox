set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: download-with-retry URL DESTINATION" >&2
  exit 2
fi

url="$1"
destination="$2"

curl \
  -fsSL \
  --retry 19 \
  --retry-delay 15 \
  --retry-max-time 300 \
  --retry-connrefused \
  "${url}" \
  -o "${destination}"
