set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: install-kwok VERSION BINDIR" >&2
  exit 2
fi

version="$1"
bin_dir="$2"
shared_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

install_binary() {
  local name="$1"
  local release_name="$2"
  local destination="${bin_dir}/${name}"
  if [[ -x "${destination}" ]]; then
    return
  fi

  echo "Installing ${name} ${version}..."
  "${shared_dir}/download-with-retry" \
    "https://github.com/kubernetes-sigs/kwok/releases/download/${version}/${release_name}" \
    "${destination}"
  chmod +x "${destination}"
}

install_binary "kwokctl" "kwokctl-linux-amd64"
install_binary "kwok" "kwok-linux-amd64"
